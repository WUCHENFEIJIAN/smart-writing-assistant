{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "tests/server"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
